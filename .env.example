# Copy this file to .env and fill in the values. Never commit .env.
# These keys are used only by the worker on your own machine, never by the app.

# Supabase project URL (public) and SECRET key (Project Settings > API Keys > Secret keys).
SUPABASE_URL=https://iifzkjjwmagjcfcdfmof.supabase.co
SUPABASE_SECRET_KEY=

# Text model: auto | claude | gemini | fake
# auto = Claude when ANTHROPIC_API_KEY is set, else Gemini when GEMINI_API_KEY is set,
# else fake sample text. Set a monthly spend limit in the Anthropic console.
LLM_PROVIDER=auto
# Claude key: https://console.anthropic.com  (API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=8000
# Free Gemini key (development fallback): https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# How long Gemini thinks before answering: low is fast (minimal/low/medium/high)
GEMINI_THINKING=low

# How long each episode's vote stays open, counted from when its video is ready.
# When the time is up the worker picks the winner (most votes; a tie goes to the
# first option) and writes the next episode from it.
POLL_HOURS=24
# For a live demo: votes last this many minutes instead (empty = use POLL_HOURS).
POLL_MINUTES=

# ---------------------------------------------------------------- images, voice, video
# auto: for images and for voice, the first provider with a key:
#   fal.ai / ElevenLabs (paid) -> Cloudflare Workers AI (free daily allowance) -> free fakes.
# Set a spending limit on any paid service before adding its key.
MEDIA_PROVIDER=auto
# Cloudflare Workers AI (free: 10,000 neurons per day, about 3 test episodes):
# dash.cloudflare.com -> AI -> Workers AI -> Use REST API (Account ID + API token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# fal.ai key: https://fal.ai/dashboard/keys
FAL_KEY=
# ElevenLabs key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Cheap test runs (course rule: short, low-resolution runs while developing):
# VIDEO_HEIGHT=960 and MEDIA_MAX_SCENES=3. For the real episode: 1920 and 0 (all scenes).
VIDEO_HEIGHT=960
MEDIA_MAX_SCENES=3

# Unit prices for the cost report (USD). Check them against your provider dashboards.
CLAUDE_USD_PER_MTOK_IN=3
CLAUDE_USD_PER_MTOK_OUT=15
FAL_USD_PER_REF=0.003
FAL_USD_PER_SCENE=0.04
ELEVENLABS_USD_PER_CHAR=0.0003
